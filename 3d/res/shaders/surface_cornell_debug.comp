#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba16f, binding = 0) uniform image2D oSurfaceDebug;

uniform ivec2 uAtlasSize;
uniform int uDebugMode;       // 0 chart id, 1 normal, 2 world position, 3 albedo, 4 valid mask
uniform int uSceneSupported;  // 1 = Cornell OBJ, 0 = fallback diagnostic tint
uniform vec3 uSceneBoundsMin;
uniform vec3 uSceneBoundsMax;

struct ChartInfo {
    int id;
    vec2 uv;
    vec3 normal;
    vec3 albedo;
    vec3 worldPos;
    bool valid;
};

vec3 chartColor(int id) {
    if (id == 1) return vec3(0.85, 0.85, 0.85); // floor
    if (id == 2) return vec3(0.55, 0.70, 1.00); // ceiling
    if (id == 3) return vec3(0.95, 0.15, 0.12); // left red wall
    if (id == 4) return vec3(0.10, 0.85, 0.18); // right green wall
    if (id == 5) return vec3(0.95, 0.95, 0.95); // back wall
    if (id == 6) return vec3(0.65, 0.65, 0.75); // front/open wall
    return vec3(0.0);
}

vec3 remapWorld(vec3 p) {
    vec3 extent = max(uSceneBoundsMax - uSceneBoundsMin, vec3(1e-4));
    return clamp((p - uSceneBoundsMin) / extent, vec3(0.0), vec3(1.0));
}

ChartInfo decodeChart(ivec2 p) {
    ChartInfo c;
    c.id = 0;
    c.uv = vec2(0.0);
    c.normal = vec3(0.0, 1.0, 0.0);
    c.albedo = vec3(0.0);
    c.worldPos = vec3(0.0);
    c.valid = false;

    // Phase 1 hardcoded Cornell packing, intentionally close to ShaderToy's
    // hardcoded chart decode style:
    //   x 0..255   floor      256x256
    //   x 256..511 ceiling    256x256
    //   x 512..639 left wall  128x256
    //   x 640..767 right wall 128x256
    //   x 768..895 back wall  128x256
    //   x 896..1023 front     128x256
    //   y 0..255 valid; y 256..511 reserved for later object/interior charts
    if (p.y >= 256 || p.x >= 1024) return c;

    vec3 bmin = uSceneBoundsMin;
    vec3 bmax = uSceneBoundsMax;
    vec3 mid = 0.5 * (bmin + bmax);

    if (p.x < 256) {
        c.id = 1;
        c.uv = (vec2(p.x, p.y) + 0.5) / vec2(256.0, 256.0);
        c.normal = vec3(0.0, 1.0, 0.0);
        c.albedo = vec3(0.82);
        c.worldPos = vec3(mix(bmin.x, bmax.x, c.uv.x), bmin.y, mix(bmin.z, bmax.z, c.uv.y));
        c.valid = true;
    } else if (p.x < 512) {
        c.id = 2;
        c.uv = (vec2(p.x - 256, p.y) + 0.5) / vec2(256.0, 256.0);
        c.normal = vec3(0.0, -1.0, 0.0);
        c.albedo = vec3(0.82);
        c.worldPos = vec3(mix(bmin.x, bmax.x, c.uv.x), bmax.y, mix(bmin.z, bmax.z, c.uv.y));
        c.valid = true;
    } else if (p.x < 640) {
        c.id = 3;
        c.uv = (vec2(p.x - 512, p.y) + 0.5) / vec2(128.0, 256.0);
        c.normal = vec3(1.0, 0.0, 0.0);
        c.albedo = vec3(0.90, 0.12, 0.10);
        c.worldPos = vec3(bmin.x, mix(bmin.y, bmax.y, c.uv.y), mix(bmin.z, bmax.z, c.uv.x));
        c.valid = true;
    } else if (p.x < 768) {
        c.id = 4;
        c.uv = (vec2(p.x - 640, p.y) + 0.5) / vec2(128.0, 256.0);
        c.normal = vec3(-1.0, 0.0, 0.0);
        c.albedo = vec3(0.10, 0.75, 0.12);
        c.worldPos = vec3(bmax.x, mix(bmin.y, bmax.y, c.uv.y), mix(bmin.z, bmax.z, c.uv.x));
        c.valid = true;
    } else if (p.x < 896) {
        c.id = 5;
        c.uv = (vec2(p.x - 768, p.y) + 0.5) / vec2(128.0, 256.0);
        c.normal = vec3(0.0, 0.0, 1.0);
        c.albedo = vec3(0.82);
        c.worldPos = vec3(mix(bmin.x, bmax.x, c.uv.x), mix(bmin.y, bmax.y, c.uv.y), bmin.z);
        c.valid = true;
    } else {
        c.id = 6;
        c.uv = (vec2(p.x - 896, p.y) + 0.5) / vec2(128.0, 256.0);
        c.normal = vec3(0.0, 0.0, -1.0);
        c.albedo = vec3(0.70);
        c.worldPos = vec3(mix(bmin.x, bmax.x, c.uv.x), mix(bmin.y, bmax.y, c.uv.y), bmax.z);
        c.valid = true;
    }

    return c;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, uAtlasSize))) return;

    ChartInfo c = decodeChart(p);
    vec3 rgb = vec3(0.02, 0.02, 0.025);
    float a = c.valid ? 1.0 : 0.0;

    if (c.valid) {
        if (uDebugMode == 0) {
            rgb = chartColor(c.id);
        } else if (uDebugMode == 1) {
            rgb = c.normal * 0.5 + 0.5;
        } else if (uDebugMode == 2) {
            rgb = remapWorld(c.worldPos);
        } else if (uDebugMode == 3) {
            rgb = c.albedo;
        } else {
            rgb = vec3(1.0);
        }

        if (uSceneSupported == 0) {
            // Keep the chart readable while tinting unsupported scenes magenta.
            rgb = mix(rgb, vec3(1.0, 0.0, 1.0), 0.25);
        }
    }

    imageStore(oSurfaceDebug, p, vec4(rgb, a));
}

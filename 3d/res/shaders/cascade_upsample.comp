#version 430 core
/**
 * Phase 2E: Cascade Upsampling/Injection Shader
 * 
 * Injects indirect lighting from coarser cascade level into finer level.
 * Uses trilinear interpolation to upsample coarse radiance to fine resolution.
 * Blends injected indirect with existing direct lighting in fine level.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform image2D oFineAtlas;

uniform sampler2D uCoarseAtlas;
uniform ivec2 uCoarseAtlasSize;
uniform ivec2 uFineAtlasSize;
uniform int uCoarseLevel;  // Which cascade level we're upsampling FROM
uniform float uInjectionWeight;  // How much to blend (default 0.5)

// Helper: Sample coarse atlas with bilinear interpolation
vec3 sampleCoarseBilinear(vec2 uv) {
    // Convert UV to texel coordinates
    vec2 coarseTexel = uv * vec2(uCoarseAtlasSize);
    vec2 texelFloor = floor(coarseTexel);
    vec2 fracPos = fract(coarseTexel);
    
    // Sample 4 neighbors
    ivec2 p00 = ivec2(texelFloor);
    ivec2 p10 = ivec2(texelFloor) + ivec2(1, 0);
    ivec2 p01 = ivec2(texelFloor) + ivec2(0, 1);
    ivec2 p11 = ivec2(texelFloor) + ivec2(1, 1);
    
    // Bounds check and sample
    vec3 c00 = vec3(0.0), c10 = vec3(0.0), c01 = vec3(0.0), c11 = vec3(0.0);
    
    if (p00.x >= 0 && p00.x < uCoarseAtlasSize.x && p00.y >= 0 && p00.y < uCoarseAtlasSize.y)
        c00 = texelFetch(uCoarseAtlas, p00, 0).rgb;
    if (p10.x >= 0 && p10.x < uCoarseAtlasSize.x && p10.y >= 0 && p10.y < uCoarseAtlasSize.y)
        c10 = texelFetch(uCoarseAtlas, p10, 0).rgb;
    if (p01.x >= 0 && p01.x < uCoarseAtlasSize.x && p01.y >= 0 && p01.y < uCoarseAtlasSize.y)
        c01 = texelFetch(uCoarseAtlas, p01, 0).rgb;
    if (p11.x >= 0 && p11.x < uCoarseAtlasSize.x && p11.y >= 0 && p11.y < uCoarseAtlasSize.y)
        c11 = texelFetch(uCoarseAtlas, p11, 0).rgb;
    
    // Bilinear interpolation
    vec3 c0 = mix(c00, c10, fracPos.x);
    vec3 c1 = mix(c01, c11, fracPos.x);
    return mix(c0, c1, fracPos.y);
}

void main() {
    ivec2 finePx = ivec2(gl_GlobalInvocationID.xy);
    
    // Bounds check
    if (finePx.x >= uFineAtlasSize.x || finePx.y >= uFineAtlasSize.y) {
        return;
    }
    
    // Read current fine-level radiance (direct lighting from mode 17)
    vec4 currentSample = imageLoad(oFineAtlas, finePx);
    vec3 fineRadiance = currentSample.rgb;
    
    // Calculate UV for sampling coarse atlas
    // Map fine pixel position to coarse UV space
    vec2 fineUV = vec2(finePx) / vec2(uFineAtlasSize);
    
    // Sample coarse level with bilinear interpolation
    vec3 coarseRadiance = sampleCoarseBilinear(fineUV);
    
    // Blend: keep direct lighting, add indirect from coarse
    // Formula: final = direct + indirect * weight
    vec3 injectedRadiance = fineRadiance + coarseRadiance * uInjectionWeight;
    
    // Store result (keep alpha as-is to indicate active probe)
    imageStore(oFineAtlas, finePx, vec4(injectedRadiance, currentSample.a));
}

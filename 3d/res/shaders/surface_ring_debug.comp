#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba16f, binding = 0) uniform image2D oRingDebug;

uniform ivec2 uAtlasSize;
uniform int uDebugMode;       // 0 chart+cascade, 1 probe coord, 2 direction coord, 3 ring, 4 world pos
uniform int uSceneSupported;
uniform int uChartActive[18];
uniform vec3 uSceneBoundsMin;
uniform vec3 uSceneBoundsMax;

const int BAND_HEIGHT = 256;
const int CASCADE_COUNT = 6;

struct ChartInfo {
    int id;
    vec2 localPx;
    vec2 gRes;
    vec2 uv;
    vec3 normal;
    vec3 tangent;
    vec3 bitangent;
    vec3 worldOrigin;
    bool valid;
};

vec3 chartColor(int id) {
    if (id == 1) return vec3(0.85, 0.85, 0.85);
    if (id == 2) return vec3(0.55, 0.70, 1.00);
    if (id == 3) return vec3(0.95, 0.15, 0.12);
    if (id == 4) return vec3(0.10, 0.85, 0.18);
    if (id == 5) return vec3(0.95, 0.95, 0.95);
    if (id == 6) return vec3(0.65, 0.65, 0.75);
    return vec3(0.0);
}

ChartInfo decodeChart(ivec2 pInBand) {
    ChartInfo c;
    c.id = 0;
    c.localPx = vec2(0.0);
    c.gRes = vec2(1.0);
    c.uv = vec2(0.0);
    c.normal = vec3(0.0, 1.0, 0.0);
    c.tangent = vec3(1.0, 0.0, 0.0);
    c.bitangent = vec3(0.0, 0.0, 1.0);
    c.worldOrigin = vec3(0.0);
    c.valid = false;

    vec3 bmin = uSceneBoundsMin;
    vec3 bmax = uSceneBoundsMax;

    if (pInBand.x < 256) {
        c.id = 1;
        c.localPx = vec2(pInBand.x, pInBand.y);
        c.gRes = vec2(256.0, 256.0);
        c.uv = (c.localPx + 0.5) / c.gRes;
        c.normal = vec3(0.0, 1.0, 0.0);
        c.tangent = vec3(1.0, 0.0, 0.0);
        c.bitangent = vec3(0.0, 0.0, 1.0);
        c.worldOrigin = vec3(bmin.x, bmin.y, bmin.z);
        c.valid = true;
    } else if (pInBand.x < 512) {
        c.id = 2;
        c.localPx = vec2(pInBand.x - 256, pInBand.y);
        c.gRes = vec2(256.0, 256.0);
        c.uv = (c.localPx + 0.5) / c.gRes;
        c.normal = vec3(0.0, -1.0, 0.0);
        c.tangent = vec3(1.0, 0.0, 0.0);
        c.bitangent = vec3(0.0, 0.0, 1.0);
        c.worldOrigin = vec3(bmin.x, bmax.y, bmin.z);
        c.valid = true;
    } else if (pInBand.x < 640) {
        c.id = 3;
        c.localPx = vec2(pInBand.x - 512, pInBand.y);
        c.gRes = vec2(128.0, 256.0);
        c.uv = (c.localPx + 0.5) / c.gRes;
        c.normal = vec3(1.0, 0.0, 0.0);
        c.tangent = vec3(0.0, 1.0, 0.0);
        c.bitangent = vec3(0.0, 0.0, 1.0);
        c.worldOrigin = vec3(bmin.x, bmin.y, bmin.z);
        c.valid = true;
    } else if (pInBand.x < 768) {
        c.id = 4;
        c.localPx = vec2(pInBand.x - 640, pInBand.y);
        c.gRes = vec2(128.0, 256.0);
        c.uv = (c.localPx + 0.5) / c.gRes;
        c.normal = vec3(-1.0, 0.0, 0.0);
        c.tangent = vec3(0.0, 1.0, 0.0);
        c.bitangent = vec3(0.0, 0.0, 1.0);
        c.worldOrigin = vec3(bmax.x, bmin.y, bmin.z);
        c.valid = true;
    } else if (pInBand.x < 896) {
        c.id = 5;
        c.localPx = vec2(pInBand.x - 768, pInBand.y);
        c.gRes = vec2(128.0, 256.0);
        c.uv = (c.localPx + 0.5) / c.gRes;
        c.normal = vec3(0.0, 0.0, 1.0);
        c.tangent = vec3(0.0, 1.0, 0.0);
        c.bitangent = vec3(1.0, 0.0, 0.0);
        c.worldOrigin = vec3(bmin.x, bmin.y, bmin.z);
        c.valid = true;
    } else if (pInBand.x < 1024) {
        c.id = 6;
        c.localPx = vec2(pInBand.x - 896, pInBand.y);
        c.gRes = vec2(128.0, 256.0);
        c.uv = (c.localPx + 0.5) / c.gRes;
        c.normal = vec3(0.0, 0.0, -1.0);
        c.tangent = vec3(0.0, 1.0, 0.0);
        c.bitangent = vec3(1.0, 0.0, 0.0);
        c.worldOrigin = vec3(bmin.x, bmin.y, bmax.z);
        c.valid = true;
    }

    return c;
}

float hash21(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, uAtlasSize))) return;

    int cascade = clamp(p.y / BAND_HEIGHT, 0, CASCADE_COUNT - 1);
    ivec2 pInBand = ivec2(p.x, p.y - cascade * BAND_HEIGHT);
    ChartInfo c = decodeChart(pInBand);
    if (c.valid && uChartActive[c.id - 1] == 0) {
        c.valid = false;
    }

    vec3 rgb = vec3(0.015, 0.015, 0.02);
    float a = c.valid ? 1.0 : 0.0;

    if (c.valid) {
        float probeSize = exp2(float(cascade + 1));
        vec2 probePositions = c.gRes / probeSize;

        // ShaderToy semantics:
        //   mod(localPx, probePositions) = which surface probe inside the chart
        //   floor(localPx / probePositions) = direction coordinate inside that probe's probeSize square
        vec2 probeCoord = mod(c.localPx, probePositions);
        vec2 dirCoord = floor(c.localPx / probePositions);
        vec2 probeUV = dirCoord + 0.5;
        vec2 probeRel = probeUV - probeSize * 0.5;
        float probeThetai = max(abs(probeRel.x), abs(probeRel.y));

        vec3 extent = max(uSceneBoundsMax - uSceneBoundsMin, vec3(1e-4));
        // Surface probe world coordinate follows ShaderToy line 130:
        // probe position advances by probeSize source texels per cascade.
        vec2 probeUVChart = clamp((probeCoord + 0.5) * probeSize / c.gRes, vec2(0.0), vec2(1.0));
        vec3 probeWorldPos = c.worldOrigin;
        if (c.id == 1) probeWorldPos = vec3(mix(uSceneBoundsMin.x, uSceneBoundsMax.x, probeUVChart.x), uSceneBoundsMin.y, mix(uSceneBoundsMin.z, uSceneBoundsMax.z, probeUVChart.y));
        if (c.id == 2) probeWorldPos = vec3(mix(uSceneBoundsMin.x, uSceneBoundsMax.x, probeUVChart.x), uSceneBoundsMax.y, mix(uSceneBoundsMin.z, uSceneBoundsMax.z, probeUVChart.y));
        if (c.id == 3) probeWorldPos = vec3(uSceneBoundsMin.x, mix(uSceneBoundsMin.y, uSceneBoundsMax.y, probeUVChart.x), mix(uSceneBoundsMin.z, uSceneBoundsMax.z, probeUVChart.y));
        if (c.id == 4) probeWorldPos = vec3(uSceneBoundsMax.x, mix(uSceneBoundsMin.y, uSceneBoundsMax.y, probeUVChart.x), mix(uSceneBoundsMin.z, uSceneBoundsMax.z, probeUVChart.y));
        if (c.id == 5) probeWorldPos = vec3(mix(uSceneBoundsMin.x, uSceneBoundsMax.x, probeUVChart.y), mix(uSceneBoundsMin.y, uSceneBoundsMax.y, probeUVChart.x), uSceneBoundsMin.z);
        if (c.id == 6) probeWorldPos = vec3(mix(uSceneBoundsMin.x, uSceneBoundsMax.x, probeUVChart.y), mix(uSceneBoundsMin.y, uSceneBoundsMax.y, probeUVChart.x), uSceneBoundsMax.z);

        vec2 disk = clamp(probeRel / max(probeSize * 0.5, 1.0), vec2(-1.0), vec2(1.0));
        float localZ = sqrt(max(0.0, 1.0 - dot(disk, disk)));
        vec3 localDir = normalize(vec3(disk.x, disk.y, localZ));
        vec3 worldDir = normalize(localDir.x * c.tangent + localDir.y * c.bitangent + localDir.z * c.normal);

        if (uDebugMode == 0) {
            vec3 base = chartColor(c.id);
            float band = float(cascade) / float(CASCADE_COUNT - 1);
            rgb = mix(base * 0.35, base, 0.45 + 0.55 * band);
            // Thin horizontal marker at each cascade band top.
            if (pInBand.y < 2) rgb = vec3(1.0, 1.0, 0.0);
        } else if (uDebugMode == 1) {
            rgb = vec3(probeCoord / max(probePositions, vec2(1.0)), float(cascade) / 5.0);
        } else if (uDebugMode == 2) {
            rgb = vec3(dirCoord / max(vec2(probeSize - 1.0), vec2(1.0)), float(cascade) / 5.0);
        } else if (uDebugMode == 3) {
            float ringNorm = probeThetai / max(probeSize * 0.5, 1.0);
            float ringStripe = step(0.5, mod(floor(probeThetai), 2.0));
            rgb = mix(vec3(ringNorm, 1.0 - ringNorm, float(cascade) / 5.0), vec3(1.0), ringStripe * 0.35);
        } else if (uDebugMode == 4) {
            rgb = clamp((probeWorldPos - uSceneBoundsMin) / extent, vec3(0.0), vec3(1.0));
        } else if (uDebugMode == 5) {
            vec3 rayOrigin = probeWorldPos + c.normal * 0.01;
            rgb = clamp((rayOrigin - uSceneBoundsMin) / extent, vec3(0.0), vec3(1.0));
        } else {
            rgb = worldDir * 0.5 + 0.5;
        }

        if (uSceneSupported == 0) {
            rgb = mix(rgb, vec3(1.0, 0.0, 1.0), 0.25);
        }
    }

    imageStore(oRingDebug, p, vec4(rgb, a));
}

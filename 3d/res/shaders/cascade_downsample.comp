#version 430 core
/**
 * Phase 2E: Cascade Downsampling Shader
 * 
 * Aggregates radiance from finer cascade level to coarser level.
 * Each coarse texel averages a 2x2 block from the fine atlas.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform image2D oCoarseAtlas;

uniform sampler2D uFineAtlas;
uniform ivec2 uFineAtlasSize;
uniform ivec2 uCoarseAtlasSize;
uniform int uFineLevel;  // Which cascade level we're downsampling FROM (0=C0, 1=C1, etc.)

void main() {
    ivec2 coarsePx = ivec2(gl_GlobalInvocationID.xy);
    
    // Bounds check
    if (coarsePx.x >= uCoarseAtlasSize.x || coarsePx.y >= uCoarseAtlasSize.y) {
        return;
    }
    
    // Each coarse texel aggregates 2x2 block from fine atlas
    ivec2 fineBase = coarsePx * 2;
    
    vec3 sum = vec3(0.0);
    int count = 0;
    
    // Sample 2x2 neighborhood from fine level
    for (int dy = 0; dy < 2; dy++) {
        for (int dx = 0; dx < 2; dx++) {
            ivec2 finePx = fineBase + ivec2(dx, dy);
            
            // Bounds check for fine atlas
            if (finePx.x < uFineAtlasSize.x && finePx.y < uFineAtlasSize.y) {
                vec4 fineSample = texelFetch(uFineAtlas, finePx, 0);
                
                // Only count active probes (alpha > 0 indicates valid data)
                if (fineSample.a > 0.0) {
                    sum += fineSample.rgb;
                    count++;
                }
            }
        }
    }
    
    // Average the samples
    vec3 avgRadiance = (count > 0) ? sum / float(count) : vec3(0.0);
    
    // Store with alpha indicating whether this texel has data
    imageStore(oCoarseAtlas, coarsePx, vec4(avgRadiance, (count > 0) ? 1.0 : 0.0));
}

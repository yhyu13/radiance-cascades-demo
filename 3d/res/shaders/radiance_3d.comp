/**
 * @file radiance_3d.comp
 * @brief Compute shader for 3D Radiance Cascade injection (Phase 5b+5c+5d trilinear)
 *
 * Phase 5b: writes per-direction radiance into a D×D tile atlas (oAtlas).
 * Phase 5c: upper-cascade merge uses per-direction texelFetch from uUpperCascadeAtlas.
 * Phase 5d: non-co-located path uses 8-neighbor spatial trilinear across upper probes.
 * Phase 5f: directional bilinear within each upper probe's D×D tile.
 * The isotropic probeGridTexture is written by reduction_3d.comp after this pass.
 */

#version 430 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// =============================================================================
// Uniforms
// =============================================================================

uniform int   uCascadeIndex;
uniform int   uCascadeCount;
uniform float uBaseInterval;   // C0's cellSize (0.125) -- always used for tMin/tMax formula
uniform float uProbeCellSize;  // this cascade's cellSize for probeToWorld()
// Phase 14c: minimum tMax for the current cascade (wu). 0 = legacy formula.
// Applied per-dispatch; C++ passes c0MinRange for C0, c1MinRange for C1, etc.
uniform float uCnMinRange;
// Phase 5d: upper-cascade spatial scale.
// 0=no upper; 1=co-located (same index); 2=non-co-located (trilinear 8-neighbor)
uniform int   uUpperToCurrentScale;
uniform float uUpperProbeCellSize;  // upper cascade's cellSize for Phase 5d trilinear
uniform ivec3 uUpperVolumeSize;     // Phase 5d trilinear: upper cascade probe grid dims for clamping
uniform int   uUseSpatialTrilinear; // Phase 5d: 1=8-neighbor trilinear (non-co-located), 0=nearest-parent

uniform ivec3 uVolumeSize;     // probe grid dimensions (e.g. 32^3)
uniform vec3  uGridSize;       // SDF volume size in world units (e.g. 4,4,4)
uniform vec3  uGridOrigin;     // SDF volume origin in world units (e.g. -2,-2,-2)

uniform vec3  uLightPos;
uniform vec3  uLightColor;
// Step 11 / Lighting controls follow-up: ambient floor strength baked into
// every cascade source surface (replaces the original hardcoded vec3(0.05)).
// Slider 0.0 = same effect as the old "strip ambient floor bake" toggle.
// Default 0.05 matches the original literal so out-of-the-box behavior is unchanged.
uniform float uAmbientBakeStrength;

// 4a: environment fill toggle
uniform int   uUseEnvFill;   // 0 = honest miss (default), 1 = fill with sky
uniform vec3  uSkyColor;     // sky color when uUseEnvFill is on

// Phase 2.5d M1 diagnostic: when set to 1, surface-hit bins write
// `clamp(sdfBefore / voxelSize, 1e-6, 1)` to alpha INSTEAD of the binary 0.
// This is for measuring the SDF-before-hit distribution (was 2.5b's failed
// soft-α derivation input). Sky / miss bins still write 0 / 1 as usual,
// so the histogram script can identify "diagnostic surface bin" via
// `0 < α < 1` strictly. Default 0 = normal Phase 2 binary α.
uniform int   uDiagAlphaMode;

// Phase 3 (bake-side leak fix via 3D WeightedSample): per-corner geometric
// visibility check at bake time. Replaces the implicit "trust upper cascade
// unconditionally" of Phase 2's smoothstep merge.
//   uUseWeightedSample: 0 (default) = bit-exact Phase 2 trilinear merge
//                       1           = WeightedSample-style per-corner gating
//   uUpperBinConeSin:   sin(theta_half) for the upper cascade's directional bin.
//                       Computed CPU-side from uUpperDirRes:
//                           cos(theta_half) = 1 - 2/D²
//                           sin(theta_half) = sqrt(1 - cos²)
//                       D=4 → 0.484, D=8 → 0.248, D=16 → 0.124.
//                       Critic 7 H2 caveat: octahedral non-uniformity may
//                       require per-bin LUT (v2 fallback).
uniform int   uUseWeightedSample;
uniform float uUpperBinConeSin;

// 2026-05-18 Phase MB (multi-bounce temporal feedback) — see doc/7/multi_bounce_temporal_plan.md
//   uUseMultiBounce: 0 (default) = single-bounce; 1 = add previous-frame C0-atlas
//                    indirect at bake-time surface hits
//   uMultiBounceGain: multiplier on feedback term. Default 0.7 for stability margin
//                     (critic-03 H1: with albedo=0.9 and gain=1.0 a closed white-walled
//                     room would amplify to direct/0.1 = 10× direct; 0.7 caps at ~2.7×).
//   uPrevFrameC0Atlas: C0's probeAtlasHistory bound at texture unit 5. Shared across
//                      all cascades (critic-03 M2) for fastest convergence + highest
//                      spatial resolution.
//   uHasPrevFrame: 0 = history not bound (first frame); shader uses 0 feedback.
//   uPrevFrameC0DirRes: D for C0 atlas (= cascadeDirRes[0]; varies with Phase 5e D-scaling).
//   uC0VolumeSize: ivec3, C0 probe grid dimensions (e.g. 32) for trilinear-blend clamping.
uniform int       uUseMultiBounce;
uniform float     uMultiBounceGain;
uniform sampler3D uPrevFrameC0Atlas;
uniform int       uHasPrevFrame;
uniform int       uPrevFrameC0DirRes;
uniform ivec3     uC0VolumeSize;
// 2026-05-18 Phase MB v2 (stochastic single-bin sampling):
// Per-frame Monte Carlo sample replaces full-hemisphere integration.
// Existing temporal EMA averages stochastic samples over time → same equilibrium
// at ~100× lower per-frame cost. Required uniform: per-frame seed entropy.
uniform uint      uMBFrameSeed;
// 2026-05-18 debug: instrument WHY Phase 3 v2 still reduces GI.
//   0 = normal (v2)
//   1 = force aFactor=1.0 in hit branch (test: does GI return if aFactor is bypassed?)
//   2 = write aFactor as visibility-grayscale into atlas .rgb (visualize where rejection is)
//   3 = write upperDir.a (visibility fraction) directly into atlas .rgb (visualize WeightedSample's output)
//   4 = force upperDir from sampleUpperDirTrilinear (test: is sampleUpperDirWeighted .rgb actually different from trilinear when corners visible?)
uniform int   uPhase3DebugMode;
uniform float uGIStrength;  // multiplier on upper contribution (default 1.0)

// =============================================================================
// Texture Bindings
// =============================================================================

uniform sampler3D uSDF;
uniform sampler3D uAlbedo;
// Phase 5c: directional upper cascade atlas — replaces isotropic uUpperCascade
uniform sampler3D uUpperCascadeAtlas;
// Phase 5 debug: isotropic fallback for A/B comparison (probeGridTexture of upper cascade)
uniform sampler3D uUpperCascade;
uniform int       uUseDirectionalMerge; // 1=directional texelFetch (5c/5f), 0=isotropic texture() (Phase 4)
uniform int       uUseDirBilinear;     // 5f: 1=bilinear across 4 direction bins (default), 0=nearest-bin (Phase 5c)
uniform int       uHasUpperCascade;
uniform float     uBlendFraction;  // 0.0 = binary (Phase 3), default 0.5
// Phase 5i: soft shadow in bake — 0=binary inShadow() (default), 1=SDF cone soft shadow
uniform int   uUseSoftShadowBake;
uniform float uSoftShadowK;        // penumbra width, shared with display shader
uniform int       uDirRes;         // Phase 5a/5e: octahedral bin resolution (D) for this cascade
uniform int       uUpperDirRes;    // Phase 5e: upper cascade D (== uDirRes when D-scaling is OFF)
uniform vec3      uProbeJitter;    // Phase 9: sub-cell jitter in [-0.5,0.5]^3 probe-cell units

// Phase 5b: per-direction atlas write target — (res*D)×(res*D)×res RGBA16F
layout(rgba16f) uniform image3D oAtlas;

// Phase 10: atlas history for fused in-bake EMA (read-only, bound when uTemporalActive=1).
// Eliminates the separate temporal_blend.comp dispatch for the atlas.
layout(rgba16f, binding=1) readonly uniform image3D uAtlasHistory;
uniform float uTemporalAlpha;   // EMA blend weight (0=keep history, 1=replace)
uniform int   uTemporalActive;  // 1=fused EMA, 0=plain write
uniform int   uClampHistory;    // 1=clamp history to neighbor AABB before EMA

// =============================================================================
// Constants
// =============================================================================

const float PI  = 3.14159265359;
const float INF = 1e10;

// =============================================================================
// Helper Functions
// =============================================================================

// Step 11 (codex 09 P0): defensive sanitization for atlas radiance writes.
// Replaces NaN/Inf with 0 and clamps to [0, 100] so downstream reduction +
// probeMeanLum stats can't be poisoned by a single corrupt texel. Alpha is
// kept separate (used as hit classification: -1=sky, 0=miss, >0=surface).
vec3 sanitizeRadiance(vec3 v) {
    v = mix(v, vec3(0.0), bvec3(isnan(v)));
    v = mix(v, vec3(0.0), bvec3(isinf(v)));
    return clamp(v, vec3(0.0), vec3(100.0));
}

vec3 probeToWorld(ivec3 probePos) {
    // Phase 5d: use uProbeCellSize (per-cascade) not uBaseInterval (always C0's 0.125)
    // Phase 9: uProbeJitter offsets the sample position within [-0.5,0.5] of the cell.
    // With temporal accumulation, each rebuild samples at a different world position,
    // widening the effective spatial footprint without adding probes.
    return uGridOrigin + (vec3(probePos) + 0.5 + uProbeJitter) * uProbeCellSize;
}

float sampleSDF(vec3 worldPos) {
    vec3 uvw = (worldPos - uGridOrigin) / uGridSize;
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0))))
        return INF;
    return texture(uSDF, uvw).r;
}

// Phase 5a: Octahedral direction encoding — full sphere ↔ [0,1]² ↔ D×D bin grid.
// Bins are analytically invertible, enabling per-direction atlas read/write.

vec2 dirToOct(vec3 dir) {
    dir /= (abs(dir.x) + abs(dir.y) + abs(dir.z));
    if (dir.z < 0.0) {
        vec2 s = sign(dir.xy) * (1.0 - abs(dir.yx));
        dir.xy = s;
    }
    return dir.xy * 0.5 + 0.5;
}

vec3 octToDir(vec2 uv) {
    uv = uv * 2.0 - 1.0;
    vec3 d = vec3(uv, 1.0 - abs(uv.x) - abs(uv.y));
    if (d.z < 0.0) d.xy = (1.0 - abs(d.yx)) * sign(d.xy);
    return normalize(d);
}

ivec2 dirToBin(vec3 dir, int D) {
    vec2 oct = dirToOct(dir);
    return clamp(ivec2(floor(oct * float(D))), ivec2(0), ivec2(D - 1));
}

vec3 binToDir(ivec2 bin, int D) {
    vec2 oct = (vec2(bin) + 0.5) / float(D);
    return octToDir(oct);
}

// Phase 5f: sample upper cascade atlas with optional directional bilinear interpolation.
// Phase 2 (interval atlas): returns vec4 — RGB radiance + α transparency interval.
// α encodes opaque (0) / transparent (1) per the paper's interval composition.
// Bilinear blends 4 surrounding bin centers instead of snapping to nearest bin.
// All bin indices are clamped to [0, D-1] — no cross-probe reads (GL_NEAREST safe).
vec4 sampleUpperDir(ivec3 upperProbePos, vec3 rayDir, int D) {
    if (uUseDirBilinear == 0) {
        ivec2 bin = dirToBin(rayDir, D);
        return texelFetch(uUpperCascadeAtlas,
            ivec3(upperProbePos.x*D+bin.x, upperProbePos.y*D+bin.y, upperProbePos.z),
            0);
    }
    vec2 octScaled = clamp(dirToOct(rayDir) * float(D) - 0.5, 0.0, float(D - 1));
    ivec2 b00 = ivec2(floor(octScaled));
    ivec2 b11 = clamp(b00 + ivec2(1), ivec2(0), ivec2(D-1));
    ivec2 b10 = ivec2(b11.x, b00.y);
    ivec2 b01 = ivec2(b00.x, b11.y);
    vec2  f   = fract(octScaled);
    int bx = upperProbePos.x * D, by = upperProbePos.y * D, bz = upperProbePos.z;
    vec4 s00 = texelFetch(uUpperCascadeAtlas, ivec3(bx+b00.x, by+b00.y, bz), 0);
    vec4 s10 = texelFetch(uUpperCascadeAtlas, ivec3(bx+b10.x, by+b10.y, bz), 0);
    vec4 s01 = texelFetch(uUpperCascadeAtlas, ivec3(bx+b01.x, by+b01.y, bz), 0);
    vec4 s11 = texelFetch(uUpperCascadeAtlas, ivec3(bx+b11.x, by+b11.y, bz), 0);
    return mix(mix(s00, s10, f.x), mix(s01, s11, f.x), f.y);
}

// Phase 5d trilinear: spatially blend 8 surrounding upper probes at the same direction bin.
// Phase 2: returns vec4 (RGB radiance + α transparency).
vec4 sampleUpperDirTrilinear(ivec3 triP000, vec3 triF, vec3 rayDir, int Du) {
    ivec3 hi   = uUpperVolumeSize - ivec3(1);
    ivec3 p100 = clamp(triP000 + ivec3(1,0,0), ivec3(0), hi);
    ivec3 p010 = clamp(triP000 + ivec3(0,1,0), ivec3(0), hi);
    ivec3 p110 = clamp(triP000 + ivec3(1,1,0), ivec3(0), hi);
    ivec3 p001 = clamp(triP000 + ivec3(0,0,1), ivec3(0), hi);
    ivec3 p101 = clamp(triP000 + ivec3(1,0,1), ivec3(0), hi);
    ivec3 p011 = clamp(triP000 + ivec3(0,1,1), ivec3(0), hi);
    ivec3 p111 = clamp(triP000 + ivec3(1,1,1), ivec3(0), hi);
    vec4 s000 = sampleUpperDir(triP000, rayDir, Du);
    vec4 s100 = sampleUpperDir(p100,   rayDir, Du);
    vec4 s010 = sampleUpperDir(p010,   rayDir, Du);
    vec4 s110 = sampleUpperDir(p110,   rayDir, Du);
    vec4 s001 = sampleUpperDir(p001,   rayDir, Du);
    vec4 s101 = sampleUpperDir(p101,   rayDir, Du);
    vec4 s011 = sampleUpperDir(p011,   rayDir, Du);
    vec4 s111 = sampleUpperDir(p111,   rayDir, Du);
    vec4 sx00 = mix(s000, s100, triF.x);
    vec4 sx10 = mix(s010, s110, triF.x);
    vec4 sx01 = mix(s001, s101, triF.x);
    vec4 sx11 = mix(s011, s111, triF.x);
    vec4 sxy0 = mix(sx00, sx10, triF.y);
    vec4 sxy1 = mix(sx01, sx11, triF.y);
    return mix(sxy0, sxy1, triF.z);
}

// =============================================================================
// Phase 3: WeightedSample (3D adaptation of ShaderToy CubeA.glsl:21-42).
// =============================================================================
//
// Per-corner geometric visibility check at bake time. For each of the 8 upper-
// cascade probes that the lower probe trilinear-interpolates over:
//   1. Compute the upper probe's world position from uGridOrigin (shared
//      across cascades) and uUpperProbeCellSize (per-cascade upper cell size).
//   2. Compute relVec = lowerProbeWorld - upperProbeWorld.
//   3. Pick the upper probe's bin facing TOWARD the lower probe (the "look-back" bin).
//   4. Read that bin's stored hit-distance (Phase 2 atlas .a; Phase 1 Mode 4 lineage).
//   5. Geometric visibility test: length(relVec) < lProbeRayDist * sin(theta_half) + 0.01.
//   6. If visible, sum the upper probe's FORWARD bin radiance (along rayDir) into the
//      weighted accumulator. If occluded, skip — this is what zeroes the bake-time leak.
//
// Returns vec4(rgb_normalized_over_visible, visibility_fraction). Caller is responsible
// for gating the merge formula by .a (see "Bake merge formula change" in §3 of plan).
//
// Returns SAME shape as sampleUpperDirTrilinear (vec4) so it's a drop-in replacement.
//
// HISTORY (do not "fix" without reading critic 13 H1):
//   The look-back direction is +normalize(relVec), NOT -normalize(relVec). ShaderToy's
//   2D WeightedSample uses `-dot(relVec, gTan)`; that negation is part of the wall-
//   attached phi atan2 axis convention (which axis is "positive" in the 2D wall-local
//   frame), NOT a "direction toward upper" semantic. In 3D world-space the direction
//   from upper-probe U to lower-probe L is `+normalize(L - U) = +normalize(relVec)`.
//   Mechanically copying ShaderToy's negation here would flip the look-back bin to
//   point AWAY from the lower probe, reading nonsense atlas data.
vec4 sampleUpperDirWeighted(ivec3 triP000, vec3 triF, vec3 rayDir, int Du,
                            vec3 lowerProbeWorld) {
    ivec3 hi = uUpperVolumeSize - ivec3(1);
    ivec3 corners[8] = ivec3[8](
        ivec3(0,0,0), ivec3(1,0,0), ivec3(0,1,0), ivec3(1,1,0),
        ivec3(0,0,1), ivec3(1,0,1), ivec3(0,1,1), ivec3(1,1,1));

    vec3  sumRgb        = vec3(0.0);
    float wVisible      = 0.0;  // sum of spatial weights for visible corners
    float wTotalSpatial = 0.0;  // sum of all spatial weights (for normalization)

    for (int i = 0; i < 8; ++i) {
        ivec3 cornerPos = clamp(triP000 + corners[i], ivec3(0), hi);

        // 3D trilinear weight (corner offsets ∈ {0,1}; formula correct only under that)
        float wx = (corners[i].x == 0) ? (1.0 - triF.x) : triF.x;
        float wy = (corners[i].y == 0) ? (1.0 - triF.y) : triF.y;
        float wz = (corners[i].z == 0) ? (1.0 - triF.z) : triF.z;
        float wSpatial = wx * wy * wz;
        wTotalSpatial += wSpatial;

        // Upper probe's world position. uGridOrigin is shared across cascades
        // (verified demo3d.cpp:3092); only cellSize differs per cascade.
        vec3 upperProbeWorld = uGridOrigin + (vec3(cornerPos) + 0.5) * uUpperProbeCellSize;

        // CRITIC 13 H1: dirToLower = +normalize(relVec), NOT -normalize. See history above.
        vec3 relVec     = lowerProbeWorld - upperProbeWorld;
        vec3 dirToLower = normalize(relVec);

        // Look-back bin: read ONLY the stored hit-distance (.a). The .rgb of this bin
        // is NOT the radiance we want (radiance comes from the FORWARD bin via
        // sampleUpperDir below). This is a single texelFetch — no need for bilinear
        // on the look-back since we only consume one scalar.
        ivec2 lookBackBin = dirToBin(dirToLower, Du);
        float lProbeRayDist = texelFetch(uUpperCascadeAtlas,
            ivec3(cornerPos.x * Du + lookBackBin.x,
                  cornerPos.y * Du + lookBackBin.y,
                  cornerPos.z), 0).a;

        // Geometric visibility check (translated from ShaderToy WeightedSample line 30-32).
        // Sky exit (lProbeRayDist < 0): always visible (nothing beyond the sky).
        // Otherwise: visible if the lower probe is within the cone of the upper bin's
        // "look toward me" ray, scaled by the bin's half-angle.
        bool visible = (lProbeRayDist < 0.0)
                    || (length(relVec) < lProbeRayDist * uUpperBinConeSin + 0.01);

        if (visible) {
            // CRITIC 13 H3: forward sample uses sampleUpperDir() to preserve Phase 5f's
            // 4-bin directional bilinear (default uUseDirBilinear==1). A single texelFetch
            // here would silently regress Phase 5f for any user with bilinear ON.
            vec4 forward = sampleUpperDir(cornerPos, rayDir, Du);
            sumRgb   += forward.rgb * wSpatial;
            wVisible += wSpatial;
        }
    }

    // Normalize over visible corners (matches Phase 2 v5 / ShaderToy renormalize-over-visible).
    // .a = "fraction of corners visible" — must be consumed by the bake merge formula
    // (see §3 of plan; CRITIC 13 L2). Without that consumer, this whole exercise is a no-op.
    return vec4(sumRgb / max(0.01, wVisible),
                wVisible / max(0.01, wTotalSpatial));
}

bool inShadow(vec3 hitPos, vec3 lightPos) {
    vec3  toLight = lightPos - hitPos;
    float dist    = length(toLight);
    vec3  dir     = toLight / dist;
    float t       = 0.05;  // offset to avoid self-intersection
    for (int i = 0; i < 32 && t < dist; ++i) {
        float d = sampleSDF(hitPos + dir * t);
        if (d < 0.002) return true;
        t += max(d * 0.9, 0.001);
    }
    return false;
}

// Phase 5i: SDF cone soft shadow for the bake shader.
// Returns shadow factor 0=lit, 1=fully shadowed (same convention as display softShadow()).
// Uses fixed t=0.05 bias — no surface normal available in the bake path.
float softShadowBake(vec3 hitPos, vec3 lightPos, float k) {
    vec3  toLight = lightPos - hitPos;
    float dist    = length(toLight);
    vec3  dir     = toLight / dist;
    float t       = 0.05;
    float res     = 1.0;
    for (int i = 0; i < 32 && t < dist; ++i) {
        float d = sampleSDF(hitPos + dir * t);
        if (d >= INF * 0.5) return 0.0;               // exited volume — unoccluded
        if (d < 0.002)      return 1.0;                // hit geometry — fully in shadow
        res = min(res, k * d / max(t, 0.001));         // cone narrowing accumulation
        t  += max(d * 0.9, 0.001);
    }
    return 1.0 - clamp(res, 0.0, 1.0);
}

// =============================================================================
// Phase MB v2: Multi-bounce indirect feedback (2026-05-18)
// =============================================================================
//
// v1 (2026-05-18 morning) did full-hemisphere integration per hit: 8 corners ×
// D² bins = 128-512 atlas fetches per surface hit. Cost was 50-100 ms per cascade
// bake — dominated by C1's worst combo of probe count + D².
//
// v2: STOCHASTIC SINGLE-BIN sampling per hit. Pick a random cosine-sampled direction
// in the upper hemisphere around the normal; sample THAT atlas bin only (8 fetches
// for trilinear blend across 8 probes). The existing temporal EMA averages
// stochastic samples over many frames → converges to the SAME equilibrium as v1's
// full hemisphere integration, but at ~100× lower per-frame cost.
//
// Monte Carlo formula:
//   Render eq:   L_o = (albedo/π) × ∫ L_i × cos(θ) dω
//   MC estimator: L_o ≈ (albedo/π) × L_i(ω) × cos(θ) / p(ω)
//   Cosine PDF:  p(ω) = cos(θ)/π
//   Substituting: L_o ≈ albedo × L_i(ω)   (cos and π cancel)
// → just `albedo × atlas_sample`. No additional normalization.

// PCG RNG + helpers — same shape as pt_reference.comp.
uint mbHash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}
uint mbPcg(inout uint state) {
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}
float mbRand1(inout uint state) { return float(mbPcg(state)) / 4294967296.0; }
vec2  mbRand2(inout uint state) { return vec2(mbRand1(state), mbRand1(state)); }

// Tangent-basis (Frisvad-style, no branches).
void mbGenTB(vec3 N, out vec3 T, out vec3 B) {
    float s = N.z < 0.0 ? -1.0 : 1.0;
    float a = -1.0 / (s + N.z);
    float b = N.x * N.y * a;
    T = vec3(1.0 + s * N.x * N.x * a, s * b, -s * N.x);
    B = vec3(b, s + N.y * N.y * a, -N.y);
}
vec3 mbCosineSample(vec3 N, vec2 r) {
    vec3 T, B; mbGenTB(N, T, B);
    r.x *= 2.0 * PI;
    float s = sqrt(1.0 - r.y);
    return T * (cos(r.x) * s) + B * (sin(r.x) * s) + N * sqrt(r.y);
}

// Trilinear-blend 8 C0 probe corners at ONE specific bin (8 fetches total).
// Returns radiance × visibility for that bin, blended spatially.
vec3 sampleC0AtlasOneBin(vec3 pos, ivec2 bin, int D) {
    if (uHasPrevFrame == 0) return vec3(0.0);
    vec3 uvw = (pos - uGridOrigin) / uGridSize;
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0))))
        return vec3(0.0);

    vec3 pg = clamp(uvw * vec3(uC0VolumeSize) - 0.5,
                    vec3(0.0), vec3(uC0VolumeSize - ivec3(1)));
    ivec3 p000 = ivec3(floor(pg));
    vec3  f    = fract(pg);
    ivec3 hi   = uC0VolumeSize - ivec3(1);

    // 8 corner trilinear weights
    ivec3 offsets[8] = ivec3[8](
        ivec3(0,0,0), ivec3(1,0,0), ivec3(0,1,0), ivec3(1,1,0),
        ivec3(0,0,1), ivec3(1,0,1), ivec3(0,1,1), ivec3(1,1,1));
    float w[8];
    w[0] = (1.0-f.x)*(1.0-f.y)*(1.0-f.z);
    w[1] =      f.x *(1.0-f.y)*(1.0-f.z);
    w[2] = (1.0-f.x)*     f.y *(1.0-f.z);
    w[3] =      f.x *     f.y *(1.0-f.z);
    w[4] = (1.0-f.x)*(1.0-f.y)*     f.z;
    w[5] =      f.x *(1.0-f.y)*     f.z;
    w[6] = (1.0-f.x)*     f.y *     f.z;
    w[7] =      f.x *     f.y *     f.z;

    vec3 acc = vec3(0.0);
    for (int i = 0; i < 8; ++i) {
        ivec3 pc = clamp(p000 + offsets[i], ivec3(0), hi);
        // Per critic-15 N3 + v2 brightness analysis: atlas .a is Phase 2 visibility.
        // For stochastic MC (cosine PDF cancels with cos in render eq), the proper
        // estimator is `albedo × L_i` — NO additional visibility weighting. The
        // atlas's .rgb at opaque-hit bins contains the surface's direct-lit color
        // (e.g., a lit wall), which IS legitimate multi-bounce source radiance.
        // Removing the `a.a` factor here matches v1 hemisphere's effective output
        // (which renormalizes over visible bins, also factoring out a.a).
        vec4 a = texelFetch(uPrevFrameC0Atlas,
                            ivec3(pc.x * D + bin.x, pc.y * D + bin.y, pc.z), 0);
        acc += a.rgb * w[i];
    }
    return acc;
}

// Stochastic single-bin feedback: pick a cosine-weighted random direction around
// the surface normal, sample that bin. Returns `L_i × albedo` factor only — the
// final albedo multiply is in the caller (matches existing convention).
vec3 sampleC0AtlasStochastic(vec3 pos, vec3 normal, uint baseSeed) {
    if (uHasPrevFrame == 0 || uPrevFrameC0DirRes <= 0) return vec3(0.0);

    // Seed: pixel-position + frame index. Each ray has its own (probePos, rayBin)
    // so we re-hash here per-hit for additional decorrelation.
    uint rng = mbHash(baseSeed ^ floatBitsToUint(pos.x) ^ (floatBitsToUint(pos.y) << 13) ^ floatBitsToUint(pos.z));
    mbPcg(rng);  // burn one

    vec2 r2  = mbRand2(rng);
    vec3 dir = mbCosineSample(normal, r2);

    int   D   = uPrevFrameC0DirRes;
    ivec2 bin = dirToBin(dir, D);
    return sampleC0AtlasOneBin(pos, bin, D);
}

// Return conventions:
//   vec4(color, 1.0)  — surface hit
//   vec4(sky,  -1.0)  — exited simulation volume and uUseEnvFill is on
//   vec4(0.0)         — in-volume miss (or volume exit with fill OFF)
vec4 raymarchSDF(vec3 origin, vec3 direction, float tMin, float tMax) {
    float t = tMin;
    const int MAX_STEPS = 128;

    for (int i = 0; i < MAX_STEPS && t < tMax; ++i) {
        vec3 pos = origin + direction * t;
        float dist = sampleSDF(pos);

        if (dist >= INF * 0.5) {
            // Exited simulation volume — either fill with sky or honest miss
            if (uUseEnvFill != 0)
                return vec4(uSkyColor, -1.0);
            else
                return vec4(0.0);
        }

        if (dist < 0.002) {
            // Surface hit — compute Lambertian shading with material albedo
            // Normal estimation step: ~1 voxel at 128^3 in 4-unit volume (4/128 = 0.03125)
            const float e = 0.03;
            vec3 n = normalize(vec3(
                sampleSDF(pos + vec3(e,0,0)) - sampleSDF(pos - vec3(e,0,0)),
                sampleSDF(pos + vec3(0,e,0)) - sampleSDF(pos - vec3(0,e,0)),
                sampleSDF(pos + vec3(0,0,e)) - sampleSDF(pos - vec3(0,0,e))
            ));

            // Sample surface albedo from volume
            vec3 uvw    = (pos - uGridOrigin) / uGridSize;
            vec3 albedo = texture(uAlbedo, uvw).rgb;

            vec3  lightDir   = normalize(uLightPos - pos);
            float shadowFact = (uUseSoftShadowBake != 0)
                ? softShadowBake(pos, uLightPos, uSoftShadowK)
                : (inShadow(pos, uLightPos) ? 1.0 : 0.0);
            float diff       = max(dot(n, lightDir), 0.0) * (1.0 - shadowFact);
            // Lighting controls follow-up: continuous bake-side ambient strength.
            // uAmbientBakeStrength=0 reproduces the Step 11 strip behavior;
            // 0.05 reproduces the original literal. ImGui slider tunes it live.
            vec3  color      = albedo * (diff * uLightColor + vec3(uAmbientBakeStrength));

            // Phase MB v2 (stochastic single-bin temporal feedback): replaces v1's
            // full-hemisphere integration (8 corners × D² fetches/hit, ~100 ms total)
            // with a single cosine-sampled bin per hit (~8 fetches). Temporal EMA
            // averages stochastic samples over many frames → SAME equilibrium as v1
            // at ~100× lower per-frame cost.
            //
            // MC formula: outgoing = albedo × atlas_sample (cosine PDF cancels with
            // cosine in render equation). See sampleC0AtlasStochastic doc.
            if (uUseMultiBounce != 0 && uHasPrevFrame != 0) {
                vec3 stochSample = sampleC0AtlasStochastic(pos, n, uMBFrameSeed);
                color += albedo * stochSample * uMultiBounceGain;
            }

            return vec4(color, t);
        }

        // Phase 8: reduced minimum step 0.01 -> 0.001 (10x finer near surfaces).
        // Hypothesis tested: 0.01 minimum caused 1cm step snapping -> probe atlas banding.
        // Result: banding unchanged after this change -- hypothesis eliminated.
        // Kept at 0.001 for sub-voxel accuracy at 128^3 (voxel = 3.125cm).
        t += max(dist * 0.9, 0.001);
    }

    return vec4(0.0);
}

// =============================================================================
// Main
// =============================================================================

void main() {
    ivec3 probePos = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(probePos, uVolumeSize))) return;

    vec3 worldPos = probeToWorld(probePos);

    // Per-cascade ray interval
    float d    = uBaseInterval;
    float tMin, tMax;
    if (uCascadeIndex == 0) {
        tMin = 0.02;
        tMax = (uCnMinRange > 0.0) ? max(d, uCnMinRange) : d;
    } else {
        float f = pow(4.0, float(uCascadeIndex - 1));
        tMin = f * d;
        tMax = (uCnMinRange > 0.0) ? max(f * 4.0 * d, uCnMinRange) : f * 4.0 * d;
    }

    float blendWidth = (tMax - tMin) * uBlendFraction;
    vec3  uvwProbe   = (worldPos - uGridOrigin) / uGridSize;  // for isotropic fallback

    // Phase 5d: upper probe index for co-located path and isotropic fallback.
    // Co-located: upperProbePos == probePos (scale=1, displacement=0, exact).
    // Non-co-located: used only by isotropic texelFetch fallback; directional path uses trilinear.
    ivec3 upperProbePos = (uUpperToCurrentScale > 0)
        ? (probePos / uUpperToCurrentScale)
        : ivec3(0);

    // Phase 5d trilinear: pre-compute 8-neighbor base corner and blend weights.
    // Only computed for non-co-located + directional merge + trilinear ON.
    // The -0.5 converts edge-aligned grid coords to center-aligned probe-center coords
    // (same pattern as directional bilinear's -0.5 in sampleUpperDir).
    // Note: Phase 5d visibility (inert — distToUpper < tMin_upper for all cascade pairs)
    // is intentionally removed. A per-neighbor weighted version would be correct but adds
    // 8x cost for a check that has never fired analytically.
    ivec3 triP000 = ivec3(0);
    vec3  triF    = vec3(0.0);
    if (uUpperToCurrentScale == 2 && uUseSpatialTrilinear != 0
            && uHasUpperCascade != 0 && uUseDirectionalMerge != 0) {
        vec3 upperGrid = (worldPos - uGridOrigin) / uUpperProbeCellSize - 0.5;
        // Clamp continuous coordinate to [0, upperRes-1] BEFORE floor/fract.
        // This is the spatial analogue of Phase 5f's:
        //   octScaled = clamp(dirToOct(dir)*D - 0.5, 0, D-1)
        // At low border:  clamped=0   → floor=0,  fract=0 → 100% probe 0
        // At high border: clamped=N-1 → floor=N-1, fract=0 → 100% probe N-1
        vec3 upperGridClamped = clamp(upperGrid,
                                      vec3(0.0),
                                      vec3(uUpperVolumeSize - ivec3(1)));
        triP000 = ivec3(floor(upperGridClamped));
        triF    = fract(upperGridClamped);
    }

    // Phase 5b+5c: per-direction loop — write each bin to atlas, merge directionally
    for (int dy = 0; dy < uDirRes; ++dy) {
        for (int dx = 0; dx < uDirRes; ++dx) {
            vec3 rayDir = binToDir(ivec2(dx, dy), uDirRes);
            vec4 hit    = raymarchSDF(worldPos, rayDir, tMin, tMax);

            // This cascade's write target -- always indexed by current probePos
            ivec3 atlasTxl = ivec3(probePos.x * uDirRes + dx,
                                   probePos.y * uDirRes + dy,
                                   probePos.z);

            // Phase 2 (interval atlas): upper cascade carries (RGB radiance + α transparency).
            // Isotropic fallback paths (no directional merge) lose α — fill α = 1 (transparent)
            // because the isotropic averages don't have meaningful per-direction occlusion.
            // Phase 3 v3 (2026-05-18, post critic-15-rev2 + empirical diagnostic):
            //   v1: renormalize-over-visible rgb + aFactor multiply (KILLED GI ~30%)
            //   v2: drop aFactor from miss branch (Cornell GI still −6% dim)
            //   v3: ALWAYS use sampleUpperDirTrilinear's .rgb; consume sampleUpperDirWeighted's
            //       visibility fraction (.a) only as the merge-formula multiplier.
            //
            // Empirical diagnostic (2026-05-18) showed v2's residual 6% dim was NOT from
            // the `* aFactor` multiply (forcing aFactor=1 made no difference); it was from
            // sampleUpperDirWeighted's renormalize (`sumRgb / wVisible`) systematically
            // biasing toward lower values. The look-back test rejects corners NEAR LIT WALLS
            // (because U near wall → look-back from U toward L hits the wall close →
            // "occluded"). Those rejected corners carry the strongest GI radiance; visible-
            // only corners are statistically dimmer. Renormalize amplifies this bias.
            //
            // v3 fix: use trilinear.rgb (full 8-corner spatial average, unbiased) for
            // radiance. Use WeightedSample only for the visibility FRACTION (wVisible /
            // wTotalSpatial), applied once at merge time as aFactor. Single attenuation
            // proportional to occluded-corner-fraction, not value-biased.
            //
            // For all non-trilinear paths (single-probe, isotropic-bilinear,
            // isotropic-texelFetch), aFactor stays 1.0 (Phase 2 unconditional-trust).
            vec4 upperDir = vec4(0.0, 0.0, 0.0, 1.0);
            vec4 upperDirTrilinear = vec4(0.0, 0.0, 0.0, 1.0);
            if (uHasUpperCascade != 0) {
                if (uUseDirectionalMerge != 0) {
                    if (uUpperToCurrentScale == 2 && uUseSpatialTrilinear != 0) {
                        upperDirTrilinear = sampleUpperDirTrilinear(triP000, triF, rayDir, uUpperDirRes);
                        if (uUseWeightedSample != 0) {
                            // v3: take .a (visibility fraction) from WeightedSample,
                            // .rgb from trilinear (unbiased spatial average).
                            // v4 Phase 2B: stale m1Delta3GatedTrilinear branch removed
                            // (DEAD per 2×2 matrix). Always use the scalar-aFactor form.
                            vec4 ws = sampleUpperDirWeighted(triP000, triF, rayDir,
                                                              uUpperDirRes, worldPos);
                            upperDir = vec4(upperDirTrilinear.rgb, ws.a);
                        } else {
                            upperDir = upperDirTrilinear;
                        }
                    } else {
                        upperDir = sampleUpperDir(upperProbePos, rayDir, uUpperDirRes);
                        upperDirTrilinear = upperDir;
                    }
                } else if (uUseDirBilinear != 0) {
                    upperDir = vec4(texture(uUpperCascade, uvwProbe).rgb, 1.0);
                    upperDirTrilinear = upperDir;
                } else {
                    upperDir = vec4(texelFetch(uUpperCascade, upperProbePos, 0).rgb, 1.0);
                    upperDirTrilinear = upperDir;
                }
            }
            // Debug mode 4 retained for A/B: same as v3 (trilinear.rgb + WS.a). When
            // uUseWeightedSample==1 it's now a no-op (v3 already does this).
            if (uPhase3DebugMode == 4) {
                upperDir = vec4(upperDirTrilinear.rgb, upperDir.a);
            }

            // Phase 2 — pragmatic "α-only" variant. (Phase 2.5b's soft-α attempt
            // via SDF-proximity smoothstep was reverted per §3.5 Tier 3 decision
            // gate: Sponza dimmed by 32% (RMSE 0.098 vs Phase 2 baseline). The
            // SDF-half-voxel-before-hit metric returns small values for ALL hits
            // — the smoothstep gave near-zero α to most surface bins. The "soft
            // α distinguishes head-on from grazing" intuition was wrong: SDF
            // proximity captures "near a surface" not "head-on hit." Reverted;
            // soft α design needs rethinking. Filed as Phase 2.6 if revisited.
            //
            // alpha encoding (Phase 2 binary, retained for now):
            //   sky exit (hit.a < 0)    → α = 0  (terminal — nothing beyond)
            //   surface hit (hit.a > 0) → α = 0  (opaque — bin occluded)
            //   in-volume miss (hit.a == 0) → α = 1  (transparent — bin visible to far field)
            //
            // M1 diagnostic mode (uDiagAlphaMode==1): surface bins write
            //   sdfBefore_normalized ∈ (0,1] instead of binary 0, so a CPU readback
            //   can compute the histogram of SDF-before-hit values and confirm
            //   whether 2.5b's failure root cause was "SDF returns small for ALL
            //   hits" or some other mechanism. Sky/miss bins unchanged.
            float alpha;
            if (hit.a > 0.0) {
                if (uDiagAlphaMode == 1) {
                    // SDF voxel size (radiance_3d.comp uses uGridSize/uGridOrigin,
                    // not uVolumeMax/Min like raymarch.frag). uSDF resolution from
                    // textureSize. uVolumeSize is the PROBE grid resolution (32 not 128).
                    ivec3 sdfRes     = textureSize(uSDF, 0);
                    float voxelSize  = uGridSize.x / float(sdfRes.x);
                    float sampleDist = max(hit.a - voxelSize * 0.5, 0.0);
                    float sdfBefore  = sampleSDF(worldPos + rayDir * sampleDist);
                    // Diagnostic-α range constants (critic 12 L4 named):
                    //   kDiagAlphaMin (1e-3): well above RGBA16F min normal (~6.1e-5)
                    //     so denormal-flush drivers don't lose the value.
                    //   kDiagAlphaMax (0.999): strictly below 1.0 so CPU histogram
                    //     filter (1e-4, 0.9995) cleanly excludes miss=1.0.
                    const float kDiagAlphaMin = 1e-3;
                    const float kDiagAlphaMax = 0.999;
                    alpha = clamp(sdfBefore / voxelSize, kDiagAlphaMin, kDiagAlphaMax);
                } else {
                    alpha = 0.0;
                }
            } else if (hit.a < 0.0) {
                alpha = 0.0;
            } else {
                alpha = 1.0;
            }

            // Original radiance bake (unchanged from pre-Phase-2):
            //
            // Phase 3 (CRITIC 13 L2 + CRITIC 14 H1 + 2026-05-17 targeted-scope refinement):
            // The upper contribution is gated by upperDir.a (visibility fraction from
            // sampleUpperDirWeighted) ONLY when uUseWeightedSample==1 AND we are in a
            // bin where leak is physically possible.
            //
            // CRITIC 14 H1: the trilinear OFF-path returns upperDir.a from the upper
            // cascade's stored α (Phase 2 binary 0/1) — applying `* upperDir.a`
            // unconditionally would silently change the OFF-mode merge. Hence the
            // `(uUseWeightedSample != 0)` mode gate on aFactor.
            //
            // 2026-05-17 TARGETED-SCOPE REFINEMENT: aFactor is now applied ONLY in the
            // hit branch (where the ray hit something inside the cascade interval and
            // the smoothstep is blending in some upper contribution that could leak past
            // the wall the ray hit). It is NOT applied in the miss branch (where the
            // ray didn't hit anything in [tMin, tMax]; by definition no wall is in the
            // way, upper's far-field is the physically correct continuation, and the
            // look-back WeightedSample test is geometrically irrelevant). Prior rev 1
            // applied aFactor on misses too — killed indirect bouncing in open volumes
            // (e.g., Cornell box interior) because WeightedSample over-rejects when U
            // and L can't see each other directly through room walls but share radiance
            // via the far field. Cerebrum 2026-05-17 has the full physics.
            //
            // **DO NOT remove the `aFactor` gating** for "simpler code".
            // v4 Phase 2B: stale m1Delta3GatedTrilinear condition removed.
            float aFactor = (uUseWeightedSample != 0) ? upperDir.a : 1.0;
            // 2026-05-18 DEBUG mode 1: force aFactor=1 to bypass WeightedSample's
            // attenuation. If image returns to OFF brightness, confirms aFactor is the
            // dimming cause; if NOT, the dimming comes from sampleUpperDirWeighted's
            // .rgb being smaller than trilinear's (different averaging weights).
            if (uPhase3DebugMode == 1) aFactor = 1.0;

            vec3 rad;
            if (hit.a < 0.0) {
                rad = hit.rgb;
            } else if (hit.a > 0.0) {
                float l = (uHasUpperCascade != 0 && blendWidth > 0.0)
                    ? 1.0 - smoothstep(0.0, 1.0,
                          clamp((hit.a - (tMax - blendWidth)) / blendWidth, 0.0, 1.0))
                    : 1.0;
                rad = hit.rgb * l + upperDir.rgb * (1.0 - l) * aFactor * uGIStrength;
            } else {
                // Miss bin: no wall in ray's path within [tMin, tMax]; full upper is
                // the correct continuation. aFactor intentionally NOT applied here
                // (see 2026-05-17 refinement comment above).
                rad = upperDir.rgb * uGIStrength;
            }

            // 2026-05-18 DEBUG modes 2/3: visualize WeightedSample internals.
            // Override rad with a grayscale visualization so the rendered image shows
            // per-bin Phase 3 state directly. Useful for "what is WeightedSample doing?"
            if (uUseWeightedSample != 0) {
                if (uPhase3DebugMode == 2) {
                    // Show aFactor: white=visible/full upper, black=fully rejected.
                    rad = vec3(aFactor);
                } else if (uPhase3DebugMode == 3) {
                    // Show upperDir.a directly (raw visibility fraction from WeightedSample,
                    // before mode-gating to aFactor).
                    rad = vec3(upperDir.a);
                }
            }

            if (uTemporalActive != 0) {
                vec4 hist = imageLoad(uAtlasHistory, atlasTxl);
                if (uClampHistory != 0) {
                    ivec3 atlasMax = ivec3(uVolumeSize.x * uDirRes,
                                          uVolumeSize.y * uDirRes,
                                          uVolumeSize.z);
                    ivec3 nbOff[6] = ivec3[6](
                        ivec3( uDirRes, 0, 0), ivec3(-uDirRes, 0, 0),
                        ivec3( 0, uDirRes, 0), ivec3( 0,-uDirRes, 0),
                        ivec3( 0, 0,  1),      ivec3( 0, 0, -1)
                    );
                    vec4 nMin = hist, nMax = hist;
                    for (int n = 0; n < 6; ++n) {
                        ivec3 nc = atlasTxl + nbOff[n];
                        if (any(lessThan(nc, ivec3(0))) || any(greaterThanEqual(nc, atlasMax))) continue;
                        vec4 nh = imageLoad(uAtlasHistory, nc);
                        nMin = min(nMin, nh);
                        nMax = max(nMax, nh);
                    }
                    // Phase 2: clamp RGB only — alpha (transparency interval) has its own
                    // valid range and must not be clamped against radiance statistics.
                    hist.rgb = clamp(hist.rgb, nMin.rgb, nMax.rgb);
                }
                vec3 histClean = sanitizeRadiance(hist.rgb);
                vec3 radClean  = sanitizeRadiance(rad);
                vec3 blended   = mix(histClean, radClean, uTemporalAlpha);
                // 2026-05-15 temporal-stability fix: EMA-blend α too. Probe jitter
                // (Phase 14a/b Halton 8 positions × 2 hold-frames) flips per-bin
                // hit/miss state every 2 frames; the previous "fresh α only" policy
                // turned that into visible flicker because raymarch.frag's
                // sampleProbeDir does `w = wcos * a.a`. EMA on α reduces consecutive-
                // frame RMSE ~40× (0.014 → 0.0003 measured INTERACTIVELY in a single
                // session on cornell-orig; max per-pixel 90/255 → 3/255).
                //
                // Trade-off: α drifts from Phase 2's binary {0,1} to a soft time-
                // average of per-bin visibility (more info, but breaks any consumer
                // that asserts α ∈ {0,1}). The bake-leak metric (counts α<0.001 bins)
                // still works as a soft threshold; numbers are not directly comparable
                // to pre-fix baselines. uDiagAlphaMode is unchanged (writes diagnostic
                // α values that survive the EMA the same way they survived pre-fix).
                float blendedAlpha = mix(hist.a, alpha, uTemporalAlpha);
                imageStore(oAtlas, atlasTxl, vec4(blended, blendedAlpha));
            } else {
                imageStore(oAtlas, atlasTxl, vec4(sanitizeRadiance(rad), alpha));
            }
        }
    }
}

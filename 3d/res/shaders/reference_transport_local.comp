#version 430

// Phase 4: local single-cascade transport over the locked ParitySceneSpec.
// Ports shader_toy/Common.glsl TraceRay and CubeA.glsl:150-192 local shading
// with temporal feedback B(hit) disabled (zero) and no upper merge.
// Payload schema ReferenceSurfaceTexelV1:
//   RGB = weighted directional irradiance contribution (finite, nonnegative)
//   A   = first-hit distance in world units; A < 0 marks a sky miss.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ---------------------------------------------------------------------------
// Request/record interface (mode 0: trace, mode 0 + synthetic flag: shade a
// supplied hit; mode 1: full-cascade band transport into the write atlas).
// ---------------------------------------------------------------------------

struct TransportRequest {
    vec4 origin;  // xyz = ray origin, w = requestType (0 = trace, 1 = synthetic hit)
    vec4 ray;     // xyz = direction, w = maxT
    vec4 hit0;    // synthetic: xyz = hit normal, w = hit distance
    vec4 hit1;    // synthetic: xyz = emission/response, w = materialKind
    vec4 misc;    // x = thetaIndex, y = probeSize, zw = unused
};

layout(std430, binding = 0) readonly buffer Requests { TransportRequest requests[]; };
layout(std430, binding = 1) writeonly buffer Records { vec4 records[]; };
layout(rgba32f, binding = 2) uniform writeonly image2D uBandImage;

// SceneGpuData v1 (2368 bytes), mirrored from reference_cornell_scene.h.
struct GpuMaterial { uvec4 metadata; vec4 response; vec4 emission; };
struct GpuChart {
    uvec4 metadata; uvec4 resolutionAndBase;
    vec4 originAndExtentU; vec4 tangentAndExtentV;
    vec4 bitangentAndTexelScaleU; vec4 normalAndTexelScaleV;
};
struct GpuPrimitive { uvec4 metadata; vec4 data0; vec4 data1; vec4 data2; vec4 data3; };

layout(std430, binding = 3) readonly buffer SceneData {
    uvec4 identity;
    uvec4 counts;
    uvec4 lightIds;
    vec4 roomBoundsMin;
    vec4 roomBoundsMax;
    vec4 referenceConstants; // x=time, y=1/256, z=interiorFrontZ, w=interiorBackZ
    vec4 sunDirection;
    vec4 sunRadiance;
    vec4 skyParameters;      // xyz=(0.7,0.8,1.0), w=0.5
    vec4 largeOpening;       // xyz=(0.5,0.0,0.25)
    vec4 smallOpening;       // xyz=(0.87,0.25,0.12)
    GpuMaterial materials[8];
    GpuChart charts[8];
    GpuPrimitive primitives[13];
} scene;

uniform int uMode;         // 0 = request evaluation, 1 = band transport
uniform int uCascade;      // band mode: target cascade 0..5
uniform int uRequestCount; // mode 0: number of requests

const float THETA_PI = 3.14192653; // reference literal (CubeA.glsl:135)
const float PI       = 3.141592653;
const float C5_REACH = 10000.0;

const int MAT_DIFFUSE    = 0;
const int MAT_BLACK      = 1;
const int MAT_REFLECTIVE = 2;
const int MAT_EMISSIVE   = 3;
const int MAT_SKY        = 4;

// ---------------------------------------------------------------------------
// Common.glsl ports
// ---------------------------------------------------------------------------

vec3 getSkyLight(vec3 d) {
    return scene.skyParameters.xyz * (1.0 - d.y * scene.skyParameters.w);
}

vec2 rotate2(vec2 p, float ang) {
    float c = cos(ang);
    float s = sin(ang);
    return vec2(p.x*c - p.y*s, p.x*s + p.y*c);
}

vec2 repeat2(vec2 p, float n) {
    float ang = 2.0*3.141592653/n;
    float sector = floor(atan(p.x, p.y)/ang + 0.5);
    return rotate2(p, sector*ang);
}

float dfBox(vec2 p, vec2 b) {
    vec2 d = abs(p - b*0.5) - b*0.5;
    return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0)));
}

bool interiorOpening(vec3 p) {
    if (length(p.xy - scene.largeOpening.xy) < scene.largeOpening.z) return true;
    if (length(p.xy - scene.smallOpening.xy) < scene.smallOpening.z) return true;
    return false;
}

bool dfIntersection(vec3 p, float t) {
    float nt = 1.0 + t*0.2;
    vec3 rp = p - vec3(scene.primitives[12].data0.x,
                       0.5,
                       scene.primitives[12].data0.z);
    vec2 rep = repeat2(rp.xz, 8.0);
    float r = length(rp.xz);
    if (p.y > 0.49 && abs(p.z - 0.5) > 0.04 && r < 0.2 && abs(r - 0.1375) > 0.01 &&
        dfBox(vec2(rep.x + 0.01, rep.y - 0.015), vec2(0.02, 0.3)) > 0.0) return true;
    return false;
}

vec3 planeNormalForChart(int chartId) {
    // Intersection-test plane normals from Common.glsl:147-179. These differ
    // from the stored chart (shading) normals for ceiling, z0, interior back.
    if (chartId == 1 || chartId == 2) return vec3(0.0, 1.0, 0.0);
    if (chartId == 3) return vec3(1.0, 0.0, 0.0);
    if (chartId == 4) return vec3(-1.0, 0.0, 0.0);
    return vec3(0.0, 0.0, -1.0);
}

struct TraceHit {
    float t;
    vec3 position;
    vec3 normal;
    int chartId;
    vec2 chartUv;
    int materialKind;
    vec3 response;
    vec3 emission;
    bool hit;
};

void applyMaterial(inout TraceHit h, uint materialId) {
    for (int m = 0; m < 8; ++m) {
        if (scene.materials[m].metadata.x == materialId) {
            h.materialKind = int(scene.materials[m].metadata.y);
            h.response = scene.materials[m].response.xyz;
            h.emission = scene.materials[m].emission.xyz;
            return;
        }
    }
    h.materialKind = MAT_DIFFUSE;
    h.response = vec3(0.0);
    h.emission = vec3(0.0);
}

TraceHit traceScene(vec3 origin, vec3 dir, float maxt, float time) {
    TraceHit h;
    h.t = maxt;
    h.position = origin + dir * maxt;
    h.normal = vec3(0.0);
    h.chartId = 0;
    h.chartUv = vec2(-1.0);
    h.materialKind = MAT_SKY;
    h.response = vec3(0.0);
    h.emission = vec3(0.0);
    h.hit = false;

    // Charted quads (primitives 0..7), Common.glsl:147-179 order.
    for (int i = 0; i < 8; ++i) {
        GpuPrimitive prim = scene.primitives[i];
        int chartId = int(prim.metadata.w);
        vec3 planeN = planeNormalForChart(chartId);
        vec3 rel = origin - prim.data0.xyz;
        vec3 tan = prim.data1.xyz;
        vec3 bit = prim.data2.xyz;
        vec2 pSize = vec2(prim.data1.w, prim.data2.w);
        float norDot = dot(planeN, dir);
        float pDot = dot(planeN, rel);
        if (sign(norDot * pDot) < -0.5) {
            float t = -pDot / norDot;
            vec3 hp = rel + dir * t;
            vec2 hit2 = vec2(dot(hp, tan), dot(hp, bit));
            if (dfBox(hit2, pSize) <= 0.0 && t > -0.5 && t < h.t) {
                vec3 wp = origin + dir * t;
                bool excluded = false;
                if (chartId <= 6 && dfIntersection(wp, time)) excluded = true;
                if (chartId >= 7 && interiorOpening(wp)) excluded = true;
                if (!excluded) {
                    h.t = t;
                    h.position = wp;
                    h.normal = prim.data3.xyz;
                    h.chartId = chartId;
                    h.chartUv = hit2 / pSize;
                    applyMaterial(h, prim.metadata.z);
                    h.hit = true;
                }
            }
        }
    }

    // Black uncharted cylinders (primitives 8..9), Common.glsl:180-187.
    for (int i = 8; i < 10; ++i) {
        GpuPrimitive prim = scene.primitives[i];
        vec3 sp = origin - vec3(prim.data0.xy, 0.0);
        float radius = prim.data1.x;
        float dxy2 = dot(dir.xy, dir.xy);
        float a = (dot(sp.xy, sp.xy) - radius*radius)/dxy2;
        float b = 2.0*dot(sp.xy, dir.xy)/dxy2;
        float re = b*b*0.25 - a;
        if (re > 0.0) {
            float st = -b*0.5 + sqrt(re); // reference keeps the +sqrt root
            float z = sp.z + dir.z*st;
            if (st > 0.0 && st < h.t && z >= prim.data0.z && z <= prim.data0.w) {
                vec2 radial = sp.xy + dir.xy*st;
                h.t = st;
                h.position = origin + dir*st;
                h.normal = -normalize(vec3(radial, 0.0));
                h.chartId = 0;
                h.chartUv = vec2(1.0);
                h.materialKind = MAT_BLACK;
                h.response = vec3(0.0);
                h.emission = vec3(0.0);
                h.hit = true;
            }
        }
    }

    // Mirror sphere (primitive 10), Common.glsl:190-193.
    {
        GpuPrimitive prim = scene.primitives[10];
        vec3 sp = origin - prim.data0.xyz;
        float radius = prim.data0.w;
        float a = dot(sp, sp) - radius*radius;
        float b = 2.0*dot(sp, dir);
        float re = b*b*0.25 - a;
        if (dot(sp, dir) < 0.0 && re > 0.0) {
            float st = -b*0.5 - sqrt(re);
            if (st > -0.5 && st < h.t) {
                h.t = st;
                h.position = origin + dir*st;
                h.normal = normalize(sp + dir*st);
                h.chartId = 0;
                h.chartUv = vec2(1.0);
                h.materialKind = MAT_REFLECTIVE;
                h.response = vec3(0.0);
                h.emission = vec3(0.0);
                h.hit = true;
            }
        }
    }

    // Mirror box (primitive 11), Common.glsl:195-203.
    {
        GpuPrimitive prim = scene.primitives[11];
        vec3 sp = origin - (prim.data0.xyz + prim.data1.xyz)*0.5;
        vec3 sd = normalize(dir);
        vec3 idir = 1.0/sd;
        vec3 bmin = prim.data0.xyz - (prim.data0.xyz + prim.data1.xyz)*0.5;
        vec3 bmax = prim.data1.xyz - (prim.data0.xyz + prim.data1.xyz)*0.5;
        vec3 tMn = (bmin - sp)*idir;
        vec3 tMx = (bmax - sp)*idir;
        vec3 t1 = min(tMn, tMx);
        vec3 t2 = max(tMn, tMx);
        vec3 signdir = -(max(vec3(0.0), sign(idir))*2.0 - 1.0);
        vec3 sn;
        if (t1.x > max(t1.y, t1.z)) sn = vec3(signdir.x, 0.0, 0.0);
        else if (t1.y > t1.z) sn = vec3(0.0, signdir.y, 0.0);
        else sn = vec3(0.0, 0.0, signdir.z);
        vec2 bb = vec2(max(max(t1.x, t1.y), t1.z), min(min(t2.x, t2.y), t2.z));
        if (bb.x > 0.0 && bb.y > bb.x && bb.x < h.t) {
            h.t = bb.x;
            h.position = origin + dir*bb.x;
            h.normal = normalize(sn);
            h.chartId = 0;
            h.chartUv = vec2(1.0);
            h.materialKind = MAT_REFLECTIVE;
            h.response = vec3(0.0);
            h.emission = vec3(0.0);
            h.hit = true;
        }
    }

    return h;
}

// ---------------------------------------------------------------------------
// CubeA.glsl:150-192 local shading (B=0, no upper merge)
// ---------------------------------------------------------------------------

float transportWeight(float thetaIndex, float probeSize) {
    float theta = thetaIndex/probeSize*THETA_PI;
    float binCount = 4.0 + 8.0*floor(thetaIndex);
    float saw = (cos(theta - PI/probeSize) - cos(theta + PI/probeSize))/binCount;
    return saw*cos(theta);
}

vec4 shadeLocal(TraceHit h, vec3 probeDir, float thetaIndex, float probeSize) {
    float w = transportWeight(thetaIndex, probeSize);
    vec3 rgb;
    float alpha;
    if (!h.hit) {
        alpha = -1.0;
        rgb = getSkyLight(probeDir);
    } else {
        alpha = h.t;
        rgb = vec3(0.0);
        if (h.materialKind == MAT_EMISSIVE) {
            rgb = h.emission;
        } else if (h.materialKind == MAT_DIFFUSE && dot(h.normal, probeDir) < 0.0) {
            vec3 direct = vec3(0.0);
            float ndl = dot(h.normal, scene.sunDirection.xyz);
            if (ndl > 0.0) {
                vec3 sPos = h.position + h.normal*0.001;
                TraceHit shadow = traceScene(sPos, scene.sunDirection.xyz, 10000.0,
                                             scene.referenceConstants.x);
                if (!shadow.hit) direct = scene.sunRadiance.xyz * ndl;
            }
            // B(hit) = 0: temporal feedback is disabled in Phase 4.
            rgb = direct * h.response;
        }
    }
    return vec4(rgb * w, alpha);
}

// ---------------------------------------------------------------------------
// Layout decode (identical to reference_layout_diag.comp; validated against
// the same golden fixtures in Phase 3).
// ---------------------------------------------------------------------------

struct ChartInfo {
    vec3 gPos, gTan, gBit, gNor;
    vec2 gRes;
    float chartId;
    float materialId;
};

bool selectChart(vec2 uv, out ChartInfo c) {
    c.chartId = 0.0;
    if (uv.x < 0.0 || uv.x >= 1024.0 || uv.y < 0.0 || uv.y >= 3072.0)
        return false;
    if (uv.y < 1536.0) {
        if (uv.x < 256.0) {
            c = ChartInfo(vec3(0.,0.,0.), vec3(1.,0.,0.), vec3(0.,0.,1.), vec3(0.,1.,0.), vec2(256.), 1.0, 1.0);
        } else if (uv.x < 512.0) {
            c = ChartInfo(vec3(0.,.5,0.), vec3(1.,0.,0.), vec3(0.,0.,1.), vec3(0.,-1.,0.), vec2(256.), 2.0, 1.0);
        } else if (uv.x < 640.0) {
            c = ChartInfo(vec3(0.,0.,0.), vec3(0.,1.,0.), vec3(0.,0.,1.), vec3(1.,0.,0.), vec2(128.,256.), 3.0, 2.0);
        } else if (uv.x < 768.0) {
            c = ChartInfo(vec3(1.,0.,0.), vec3(0.,1.,0.), vec3(0.,0.,1.), vec3(-1.,0.,0.), vec2(128.,256.), 4.0, 3.0);
        } else if (uv.x < 896.0) {
            c = ChartInfo(vec3(0.,0.,0.), vec3(0.,1.,0.), vec3(1.,0.,0.), vec3(0.,0.,1.), vec2(128.,256.), 5.0, 1.0);
        } else {
            c = ChartInfo(vec3(0.,0.,1.), vec3(0.,1.,0.), vec3(1.,0.,0.), vec3(0.,0.,-1.), vec2(128.,256.), 6.0, 1.0);
        }
        return true;
    }
    if (uv.x < 128.0) {
        c = ChartInfo(vec3(0.,0.,0.47 - 1./256.), vec3(0.,1.,0.), vec3(1.,0.,0.), vec3(0.,0.,-1.), vec2(128.,256.), 7.0, 4.0);
        return true;
    }
    if (uv.x < 256.0) {
        c = ChartInfo(vec3(0.,0.,0.53 - 1./256.), vec3(0.,1.,0.), vec3(1.,0.,0.), vec3(0.,0.,1.), vec2(128.,256.), 8.0, 4.0);
        return true;
    }
    return false;
}

float piecewisePhi(vec2 rel, float thetai) {
    float phi = 0.0;
    if (rel.x + 0.5 > thetai && rel.y - 0.5 > -thetai) {
        phi = rel.x - rel.y;
    } else if (rel.y - 0.5 < -thetai && rel.x - 0.5 > -thetai) {
        phi = thetai*2. - rel.y - rel.x;
    } else if (rel.x - 0.5 < -thetai && rel.y + 0.5 < thetai) {
        phi = thetai*4. - rel.x + rel.y;
    } else if (rel.y + 0.5 > thetai && rel.x + 0.5 < thetai) {
        phi = thetai*8. - (rel.y - rel.x);
    }
    return phi;
}

struct ProbeDecode {
    bool isActive;
    vec3 probePos;
    vec3 probeDir;
    float thetaIndex;
    float probeSize;
    float interval;
};

ProbeDecode decodeProbe(vec2 uv) {
    ProbeDecode p;
    p.isActive = false;
    p.probePos = vec3(0.0);
    p.probeDir = vec3(0.0);
    p.thetaIndex = 0.0;
    p.probeSize = 0.0;
    p.interval = 0.0;
    ChartInfo c;
    if (!selectChart(uv, c))
        return p;
    float probeCascade = floor(mod(uv.y, 1536.0) / 256.0);
    float probeSize = pow(2.0, probeCascade + 1.0);
    vec2 modUV = mod(uv, c.gRes);
    vec2 probePositions = c.gRes / probeSize;
    vec3 probePos = c.gPos + mod(modUV.x, probePositions.x)*probeSize/256.*c.gTan
                             + mod(modUV.y, probePositions.y)*probeSize/256.*c.gBit;
    vec2 probeUV = floor(modUV / probePositions) + 0.5;
    vec2 probeRel = probeUV - probeSize*0.5;
    float thetai = max(abs(probeRel.x), abs(probeRel.y));
    float theta = thetai/probeSize*THETA_PI;
    float phiU = piecewisePhi(probeRel, thetai);
    float binCount = 4. + 8.*floor(thetai);
    float phi = phiU*PI*2./binCount;
    vec3 localDir = vec3(vec2(sin(phi), cos(phi))*sin(theta), cos(theta));
    vec3 probeDir = localDir.x*c.gTan + localDir.y*c.gBit + localDir.z*c.gNor;
    float tInterval = (1./64.)*probeSize*2.;
    if (probeCascade > 4.5) tInterval = C5_REACH;
    p.isActive = true;
    p.probePos = probePos;
    p.probeDir = probeDir;
    p.thetaIndex = thetai;
    p.probeSize = probeSize;
    p.interval = tInterval;
    return p;
}

// ---------------------------------------------------------------------------

void main() {
    if (uMode == 0) {
        uint idx = gl_GlobalInvocationID.y * 8u + gl_GlobalInvocationID.x;
        if (int(idx) >= uRequestCount)
            return;
        TransportRequest req = requests[idx];
        vec4 outRgba;
        if (req.origin.w > 0.5) {
            // Synthetic hit category coverage (e.g. emissive, which the locked
            // scene does not instantiate as geometry).
            TraceHit h;
            h.t = req.hit0.w;
            h.position = req.origin.xyz;
            h.normal = req.hit0.xyz;
            h.chartId = 0;
            h.chartUv = vec2(-1.0);
            h.materialKind = int(req.hit1.w + 0.5);
            h.response = req.hit1.xyz;
            h.emission = req.hit1.xyz;
            h.hit = true;
            outRgba = shadeLocal(h, normalize(req.ray.xyz), req.misc.x, req.misc.y);
        } else {
            float time = scene.referenceConstants.x;
            TraceHit h = traceScene(req.origin.xyz, normalize(req.ray.xyz),
                                    req.ray.w, time);
            outRgba = shadeLocal(h, normalize(req.ray.xyz), req.misc.x, req.misc.y);
        }
        records[idx] = outRgba;
        return;
    }

    // Band transport: physical texel -> layout -> trace -> local shading.
    // Inactive texels retain the cleared-state payload (0,0,0,-1).
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= 1024 || texel.y >= 512)
        return;
    float bandY0 = 256.0*float(uCascade);
    vec2 globalUv = (texel.y < 256)
        ? vec2(float(texel.x), float(texel.y) + bandY0)
        : vec2(float(texel.x), float(texel.y) + (1280.0 + bandY0));
    globalUv += 0.5;

    ProbeDecode probe = decodeProbe(globalUv);
    if (!probe.isActive) {
        imageStore(uBandImage, texel, vec4(0.0, 0.0, 0.0, -1.0));
        return;
    }
    float time = scene.referenceConstants.x;
    // Ray origin bias along the chart normal, from CubeA.glsl:153.
    vec3 chartNormal;
    if (globalUv.y < 1536.0) {
        if (globalUv.x < 256.0) chartNormal = vec3(0.,1.,0.);
        else if (globalUv.x < 512.0) chartNormal = vec3(0.,-1.,0.);
        else if (globalUv.x < 640.0) chartNormal = vec3(1.,0.,0.);
        else if (globalUv.x < 768.0) chartNormal = vec3(-1.,0.,0.);
        else if (globalUv.x < 896.0) chartNormal = vec3(0.,0.,1.);
        else chartNormal = vec3(0.,0.,-1.);
    } else {
        chartNormal = (globalUv.x < 128.0) ? vec3(0.,0.,-1.) : vec3(0.,0.,1.);
    }
    vec3 origin = probe.probePos + chartNormal*0.001;
    TraceHit h = traceScene(origin, probe.probeDir, probe.interval, time);
    imageStore(uBandImage, texel,
               shadeLocal(h, probe.probeDir, probe.thetaIndex, probe.probeSize));
}

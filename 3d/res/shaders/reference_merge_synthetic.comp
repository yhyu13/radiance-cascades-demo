#version 430

// Phase 5 G6 synthetic upper-merge validator. Implements the same approved
// candidate-clamped WeightedSample semantics as the CPU oracle. Texture alpha
// is read only from the distinct look-back address; radiance addresses supply
// RGB only. Full hierarchy integration remains in reference_transport_local.

layout(local_size_x=8,local_size_y=1,local_size_z=1) in;

struct Req {
    vec4 uvLocal; // xy=global UV, zw=local R,G
    vec4 localB;  // x=local B,y=trace distance,z=local alpha,w=unused
    vec4 alphas;
    vec4 color0;
    vec4 color1;
    vec4 color2;
    vec4 color3;
};
struct Rec { vec4 merged; vec4 upper; vec4 meta; };
layout(std430,binding=0) readonly buffer Requests { Req reqs[]; };
layout(std430,binding=1) writeonly buffer Records { Rec recs[]; };
uniform int uCount;

float modp(float a,float b){return a-b*floor(a/b);}
void chart(vec2 uv,out vec2 res,out vec3 pos,out vec3 t,out vec3 b){
 if(uv.y<1536.){if(uv.x<256.){res=vec2(256);pos=vec3(0);t=vec3(1,0,0);b=vec3(0,0,1);}
 else if(uv.x<512.){res=vec2(256);pos=vec3(0,.5,0);t=vec3(1,0,0);b=vec3(0,0,1);}
 else if(uv.x<640.){res=vec2(128,256);pos=vec3(0);t=vec3(0,1,0);b=vec3(0,0,1);}
 else if(uv.x<768.){res=vec2(128,256);pos=vec3(1,0,0);t=vec3(0,1,0);b=vec3(0,0,1);}
 else if(uv.x<896.){res=vec2(128,256);pos=vec3(0);t=vec3(0,1,0);b=vec3(1,0,0);}
 else{res=vec2(128,256);pos=vec3(0,0,1);t=vec3(0,1,0);b=vec3(1,0,0);}}
 else{res=vec2(128,256);pos=uv.x<128.?vec3(0,0,.47-1./256.):vec3(0,0,.53-1./256.);t=vec3(0,1,0);b=vec3(1,0,0);}}

void main(){uint id=gl_GlobalInvocationID.x;if(int(id)>=uCount)return;Req q=reqs[id];vec2 uv=q.uvLocal.xy;vec2 res;vec3 gp,gt,gb;chart(uv,res,gp,gt,gb);
 float c=floor(mod(uv.y,1536.)/256.),S=pow(2.,c+1.),SU=S*2.;vec2 m=mod(uv,res),pp=res/S,up=pp*.5;
 vec3 probe=gp+gt*(mod(m.x,pp.x)*S/256.)+gb*(mod(m.y,pp.y)*S/256.);vec2 origin=floor(uv/res)*res+vec2(0,res.y),dirs=floor(m/pp)*pp;
 vec2 p=clamp(mod(m,pp)*.5,vec2(.5),up-.5),fr=fract(p-.5),base=floor(p-.5)+.5;vec2 os[4]=vec2[4](vec2(0),vec2(1,0),vec2(0,1),vec2(1));
 float ws[4]=float[4]((1.-fr.x)*(1.-fr.y),fr.x*(1.-fr.y),(1.-fr.x)*fr.y,fr.x*fr.y);vec3 cols[4]=vec3[4](q.color0.rgb,q.color1.rgb,q.color2.rgb,q.color3.rgb);
 vec3 num=vec3(0);float vw=0.;for(int i=0;i<4;i++){vec2 cp=clamp(base+os[i],vec2(.5),up-.5);vec3 wp=gp+gt*(cp.x*SU/256.)+gb*(cp.y*SU/256.);vec3 rel=probe-wp;
  float th=(SU*.5-.5)/(SU*.5)*3.141592653*.5,cone=cos(3.141592653*.5-th);bool vis=q.alphas[i]<-.5||length(rel)<q.alphas[i]*cone+.01;
  if(vis){num+=cols[i]*4.*ws[i];vw+=ws[i];}}
 vec3 upper=num/max(.01,vw);float baseT=(1./256.)*S*1.5,mn=c<.5?0.:baseT,inter=c<.5?baseT*2.:baseT,l=1.-clamp((q.localB.y-mn)/inter,0.,1.);vec3 local=vec3(q.uvLocal.zw,q.localB.x);
 recs[id].merged=vec4(mix(upper,local,l),q.localB.z);recs[id].upper=vec4(upper,vw);recs[id].meta=vec4(l,c,S,0);}

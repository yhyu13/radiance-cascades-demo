t</li>
            <li><b>Global Variable Qualifiers:</b> const</li>
            <li><b>Vector Components:</b> .xyzw .rgba .stpq</li>
            <li><b>Flow Control:</b> if else for return break continue swit=
ch/case</li>
            <li><b>Output:</b> vec4 fragColor</li>
            <li><b>Input:</b> vec2 fragCoord</li>
            <li><b>Preprocessor:</b> #define #undef #if #ifdef #ifndef #els=
e #elif #endif #error #pragma #line</li>
